{"id": "sql-count", "kind": "sql", "question": "Combien de lignes ?", "reply": "SELECT count(*) AS n FROM \"c1\"", "expect": "accept", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-top", "kind": "sql", "question": "Les 5 plus peuplées", "reply": "SELECT name, population FROM \"c1\" ORDER BY population DESC LIMIT 5", "expect": "accept", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-group", "kind": "sql", "question": "Surface moyenne par nom", "reply": "SELECT name, avg(surface) AS s FROM \"c1\" GROUP BY name", "expect": "accept", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-where", "kind": "sql", "question": "Communes de plus de 1000 habitants", "reply": "SELECT * FROM \"c1\" WHERE population > 1000", "expect": "accept", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-cte", "kind": "sql", "question": "Part de la plus grande", "reply": "WITH t AS (SELECT max(surface) AS m FROM \"c1\") SELECT m FROM t", "expect": "accept", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-window", "kind": "sql", "question": "Rang par surface", "reply": "SELECT name, rank() OVER (ORDER BY surface DESC) AS r FROM \"c1\"", "expect": "accept", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-sum-fenced", "kind": "sql", "question": "Population totale", "reply": "SELECT sum(population) FROM \"c1\"", "expect": "accept", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-drop", "kind": "sql", "question": "Supprime la table", "reply": "DROP TABLE \"c1\"", "expect": "reject", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-insert", "kind": "sql", "question": "Ajoute une ligne", "reply": "INSERT INTO \"c1\" VALUES ('a', 1, 1.0)", "expect": "reject", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-update", "kind": "sql", "question": "Mets à jour", "reply": "UPDATE \"c1\" SET population = 0", "expect": "reject", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-two", "kind": "sql", "question": "Deux requêtes", "reply": "SELECT 1; SELECT * FROM \"c1\"", "expect": "reject", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-other-table", "kind": "sql", "question": "Autre collection", "reply": "SELECT * FROM \"c2\"", "expect": "reject", "match": "table non autorisée", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-join-other", "kind": "sql", "question": "Jointure", "reply": "SELECT * FROM \"c1\" JOIN \"c2\" ON true", "expect": "reject", "match": "table non autorisée", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-unknown-col", "kind": "sql", "question": "Colonne inventée", "reply": "SELECT habitants FROM \"c1\"", "expect": "reject", "match": "habitants", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-unknown-col-where", "kind": "sql", "question": "Filtre sur colonne inventée", "reply": "SELECT * FROM \"c1\" WHERE altitude > 10", "expect": "reject", "match": "altitude", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-read-file", "kind": "sql", "question": "Lis un fichier", "reply": "SELECT * FROM read_csv('/etc/passwd')", "expect": "reject", "match": "fonction de table", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-attach", "kind": "sql", "question": "Attache une base", "reply": "ATTACH 'x.db' AS x", "expect": "reject", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-copy", "kind": "sql", "question": "Exporte", "reply": "COPY \"c1\" TO '/tmp/x.csv'", "expect": "reject", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "sql-garbage", "kind": "sql", "question": "Du texte", "reply": "Voici la requête demandée", "expect": "reject", "table": "c1", "fields": [{"name": "name", "type": "string"}, {"name": "population", "type": "integer"}, {"name": "surface", "type": "number"}], "extra": ["id", "geom"]}
{"id": "cel-ok-vars", "kind": "cel", "question": "Visible si statut ouvert", "reply": "vars.statut == \"ouvert\"", "expect": "accept", "available": ["vars.statut", "record.population", "record.name", "user.name"]}
{"id": "cel-ok-record", "kind": "cel", "question": "Population élevée", "reply": "record.population > 1000", "expect": "accept", "available": ["vars.statut", "record.population", "record.name", "user.name"]}
{"id": "cel-ok-user", "kind": "cel", "question": "Utilisateur nommé", "reply": "user.name != ''", "expect": "accept", "available": ["vars.statut", "record.population", "record.name", "user.name"]}
{"id": "cel-ok-and", "kind": "cel", "question": "Ouvert et peuplé", "reply": "vars.statut == \"ouvert\" && record.population > 10", "expect": "accept", "available": ["vars.statut", "record.population", "record.name", "user.name"]}
{"id": "cel-unknown-var", "kind": "cel", "question": "Variable inventée", "reply": "vars.inconnue == 1", "expect": "reject", "match": "vars.inconnue", "available": ["vars.statut", "record.population", "record.name", "user.name"]}
{"id": "cel-unknown-record", "kind": "cel", "question": "Champ inventé", "reply": "record.altitude > 1", "expect": "reject", "match": "record.altitude", "available": ["vars.statut", "record.population", "record.name", "user.name"]}
{"id": "cel-syntax", "kind": "cel", "question": "Syntaxe cassée", "reply": "vars.statut ==", "expect": "reject", "available": ["vars.statut", "record.population", "record.name", "user.name"]}
{"id": "cel-bare-root", "kind": "cel", "question": "Racine nue", "reply": "size(vars) > 0", "expect": "reject", "match": "racine nue", "available": ["vars.statut", "record.population", "record.name", "user.name"]}
{"id": "cel-dynamic-index", "kind": "cel", "question": "Index dynamique", "reply": "vars[record.name] == 1", "expect": "reject", "available": ["vars.statut", "record.population", "record.name", "user.name"]}
{"id": "cel-ctx-root", "kind": "cel", "question": "Racine non déclarée", "reply": "ctx.x == 1", "expect": "reject", "match": "ctx.x", "available": ["vars.statut", "record.population", "record.name", "user.name"]}
