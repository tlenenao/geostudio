# ─── PostgreSQL / PostGIS ────────────────────────────────
PG_PASSWORD=ChangezMoiImmediatement!

# ─── MinIO (stockage objets S3-compatible) ───────────────
MINIO_USER=minioadmin
MINIO_PASSWORD=MinioSecret_ChangezMoi123

# ─── Keycloak (authentification SSO) ─────────────────────
KC_PASSWORD=KeycloakAdmin_ChangezMoi!

# ─── Traefik / Let's Encrypt (SSL) ───────────────────────
ACME_EMAIL=admin@votre-domaine.fr
DOMAIN=gis.votre-domaine.fr

# ─── Martin (orpheline connue — générée, jamais consommée) ─
# Régler cette valeur ne change rien à ce jour : aucun service ne lit
# MARTIN_SECRET (dérive pré-existante documentée depuis SP-1d3/SP-9, jamais
# câblée sur `martin` — hors périmètre à ces deux occasions). La ligne reste
# active (pas commentée comme le bloc S3 ci-dessous) parce que
# scripts/bootstrap-env.sh la génère par un `sed` qui a besoin d'une ligne
# `MARTIN_SECRET=...` non commentée pour la remplacer.
MARTIN_SECRET=martin-client-secret

# ─── Cœur : mode d'authentification ──────────────────────
# "mock" pour dev/e2e (aucun accès réseau à Keycloak requis) ; "oidc" en usage réel.
CORE_AUTH_MODE=mock
# Marqueur explicite requis quand CORE_AUTH_MODE=mock (SP-26/3.1) — le
# cœur refuse de démarrer sinon. Ne jamais mettre "development" sur une
# instance exposée publiquement.
CORE_ENV=development
CORE_OIDC_ISSUER=http://localhost:8180/realms/geostudio
CORE_OIDC_AUDIENCE=geostudio-core
# JWKS fetched from inside the core container, via the internal docker network —
# deliberately different from CORE_OIDC_ISSUER (which must match what a real
# browser's token actually carries as `iss`, i.e. the externally published port).
CORE_OIDC_JWKS_URL=http://keycloak:8080/realms/geostudio/protocol/openid-connect/certs

# ─── Cœur : MCP (serveur d'outils authentifié) ───────────
# Audience distincte de CORE_OIDC_AUDIENCE — les tokens émis pour l'API REST
# du shell ne sont pas valides pour /mcp, et inversement.
CORE_MCP_AUDIENCE=geostudio-mcp
# URL externe joignable du cœur — sert à construire l'identifiant de
# ressource /mcp et le document de métadonnées RFC 9728. Également embarquée
# telle quelle dans chaque bundle d'export d'app en mode Connecté (SP-18b) :
# c'est l'URL que le navigateur du bundle appellera. Un déploiement réel
# derrière un reverse proxy/domaine doit donc fixer cette valeur sur son URL
# joignable de l'extérieur, pas laisser le défaut localhost.
CORE_BASE_URL=http://localhost:8200
# Cible INTERNE du rappel HTTP que le copilote (SP-20) fait vers /mcp depuis
# le process `core` lui-même. Distincte de CORE_BASE_URL ci-dessus, qui est
# l'identité publique : derrière un reverse proxy, CORE_BASE_URL vaut
# https://<hôte>/api, que le conteneur ne peut pas joindre depuis l'intérieur
# du réseau Docker (hairpin NAT) et que la garde anti-DNS-rebinding du serveur
# MCP rejette de toute façon. À laisser sur localhost:8200 (le process
# lui-même) dans tous les déploiements packagés.
CORE_INTERNAL_BASE_URL=http://localhost:8200

# ─── Cœur : copilote IA embarqué (SP-20) ─────────────────
# Vide (défaut) : le copilote est désactivé, le routeur POST /copilot/turn
# n'est pas monté, l'onglet n'apparaît pas dans le builder. "openai" active
# le fournisseur HTTP compatible OpenAI (chat completions + tool calling
# standard — vLLM/Ollama/LM Studio et la plupart des passerelles locales
# l'exposent aussi).
CORE_LLM_PROVIDER=
CORE_LLM_API_URL=
CORE_LLM_API_KEY=
CORE_LLM_MODEL=gpt-4o-mini

# Rôle analyste (SP-11c) — subs OIDC autorisés à /analytics/sql, séparés par
# des virgules. Vide = personne.
CORE_ANALYST_SUBS=

# ─── Cœur : stockage S3/MinIO (identifiants, endpoint, buckets) ─
# Tout ce bloc est commenté à dessein (revue finale SP-21, item 2) : chaque
# nom ci-dessous est lu par core/app/, mais AUCUN n'est réglable depuis ce
# fichier — docker-compose.yml fixe soit une autre variable (identifiants),
# soit la valeur en dur (buckets). Décommenter et régler l'une de ces
# lignes ne change rien à la stack packagée ; c'est exactement l'illusion
# « documenté donc câblé » que ce bloc existe pour couper (CORE_ETL_ENABLED
# en fut le premier exemple). Les changer exige de modifier
# docker-compose.yml (et deploy/backup/backup.sh pour un bucket sauvegardé).
#
# Identifiants/endpoint : chaque service reçoit en réalité
# `S3_ACCESS_KEY: ${MINIO_USER}` et `S3_SECRET_KEY: ${MINIO_PASSWORD}`
# (les deux définies plus haut dans ce fichier) et une URL S3 fixée en dur.
#   S3_ENDPOINT_URL=http://minio:9000
#   S3_ACCESS_KEY=${MINIO_USER}
#   S3_SECRET_KEY=${MINIO_PASSWORD}
#
# Buckets fixés en dur dans docker-compose.yml :
#   S3_THUMBNAILS_BUCKET=geostudio-thumbnails  (sauvegardé)
#   S3_UPLOADS_BUCKET=geostudio-uploads        (sauvegardé)
#   S3_TILESET3D_BUCKET=geostudio-tileset3d    (sauvegardé)
#   S3_TERRAIN3D_BUCKET=geostudio-terrain3d    (sauvegardé — section
#                                                CORE_TERRAIN3D_ENABLED plus bas)
#   S3_CDC_BUCKET=geostudio-cdc                (sauvegardé)
#   S3_EXPORTS_BUCKET=geostudio-exports        (NON sauvegardé — régénérable)
#   S3_APPEXPORTS_BUCKET=geostudio-appexports  (NON sauvegardé — régénérable)

# ─── Cœur : fournisseur d'embeddings (recherche sémantique, SP-7) ────
# "fake" pour dev/test/mock (aucun accès réseau) ; "openai" en usage réel.
CORE_EMBEDDING_PROVIDER=fake
# Requis seulement si CORE_EMBEDDING_PROVIDER=openai — endpoint HTTP
# compatible OpenAI (POST {input, model} -> {data:[{embedding}]}), ex.
# https://api.openai.com/v1/embeddings ou un endpoint Voyage compatible.
CORE_EMBEDDING_API_URL=
CORE_EMBEDDING_API_KEY=
CORE_EMBEDDING_MODEL=text-embedding-3-small

# ─── Cœur : mode démo (lecture seule, SP-9) ──────────────
# "true" pour une démo publique où toute écriture (REST + MCP) est refusée,
# quel que soit l'utilisateur, y compris admin ; "false" (défaut) en usage
# normal.
CORE_READ_ONLY_MODE=false
CORE_ETL_ENABLED=false
CORE_EXPORT_ENABLED=false
# Export d'apps/dashboards en bundle statique autoporté (zip : runtime
# prébâti + config gelée, aucun backend GeoStudio requis à l'exécution) —
# "false" (défaut) ne monte pas le routeur app.appexport ; le point
# d'entrée d'export du builder disparaît aussi. Service compose dédié
# (`appexport-runtime-builder`) derrière le profil `appexport`. Active
# aussi le mode Connecté (SP-18b, bundle qui continue d'appeler le cœur en
# anonyme) : ce flag installe alors un middleware CORS origine-wildcard,
# sans credentials, sur un jeu restreint d'endpoints déjà anonymes en
# lecture seule (cf. _APPEXPORT_CORS_RULES dans app/main.py).
CORE_APPEXPORT_ENABLED=false
# Hébergement de tilesets 3D Tiles uploadés (zip → S3 → item, proxy de
# lecture authentifié) — "false" (défaut) ne monte pas le routeur
# app.tileset3d ; le point d'entrée d'upload du shell disparaît aussi.
CORE_TILESET3D_ENABLED=false
# Garde-fous de validation du zip de tileset (lus par
# core/app/tileset3d/jobs.py) — optionnels, valeurs par défaut entre
# parenthèses, à ne surcharger que pour un usage atypique.
# Nombre maximal d'entrées du zip (défaut 20000).
#CORE_TILESET3D_MAX_ENTRIES=20000
# Taille décompressée cumulée maximale, en octets (défaut 20 Gio).
#CORE_TILESET3D_MAX_TOTAL_BYTES=21474836480
# Taille décompressée maximale d'une seule entrée, en octets (défaut 2 Gio),
# appliquée à la validation du zip à l'upload.
#CORE_TILESET3D_MAX_ENTRY_BYTES=2147483648
# Plafond de service par requête du proxy GET /tileset3d/{item_id}/{path}, en
# octets (défaut 128 Mio) — distinct (et bien plus bas) que le plafond de
# validation ci-dessus : une entrée validée mais plus grosse que ce plafond
# est refusée en 413 plutôt que servie.
#CORE_TILESET3D_MAX_PROXY_READ_BYTES=134217728
# Terrain DEM hébergé (upload GeoTIFF brut → conversion COG côté worker →
# proxy de tuiles terrarium via notre TiTiler) — "false" (défaut) ne monte
# pas le routeur app.terrain3d ; le sélecteur de DEM hébergé du shell
# disparaît aussi.
CORE_TERRAIN3D_ENABLED=false
# S3_TERRAIN3D_BUCKET : figé en dur dans docker-compose.yml, cf. le bloc
# S3/MinIO commenté plus haut dans ce fichier — pas une ligne à régler ici.
# URL interne (réseau docker) du service TiTiler — inchangée dans la
# plupart des déploiements, seule une topologie non standard la fait varier.
#TITILER_URL=http://titiler:8000
# Taille max de l'upload GeoTIFF brut, en octets (défaut 2 Gio), vérifiée
# côté worker avant de lancer la conversion (convert_terrain3d_task).
#CORE_TERRAIN3D_MAX_UPLOAD_BYTES=2147483648
# Délai max de la conversion GDAL elle-même, en secondes (défaut 15 min) —
# passé ce délai, le job passe "error" plutôt que de bloquer la file
# terrain3d indéfiniment (conversion.convert_to_cog, process fils tué au
# délai — plus signal.alarm, cassé dans un thread worker procrastinate).
#CORE_TERRAIN3D_CONVERSION_TIMEOUT_SECONDS=900
# Secret HMAC signant les jetons d'export éphémères (SP-17a) — chaîne
# quelconque, pas de format base64 requis (contrairement à
# CORE_SECRETS_MASTER_KEY). Lu paresseusement (os.environ[...], échec
# rapide) seulement quand un jeton est réellement minté/décodé — une
# instance qui n'active jamais CORE_EXPORT_ENABLED n'a pas besoin de le
# définir. Générer avec : openssl rand -base64 32
CORE_EXPORT_TOKEN_SECRET=
# URL interne (réseau docker) du service shell, utilisée UNIQUEMENT par
# export-worker pour naviguer vers la page runtime à exporter — jamais
# exposée publiquement. Le défaut du docker-compose.yml (http://shell:8300)
# suffit en développement ; à ne surcharger qu'en déploiement où le service
# shell n'est pas nommé "shell" sur le réseau docker.
SHELL_BASE_URL=http://shell:8300
# CONTRAINTE (revue finale SP-17a, I8, corrigée en 2e revue finale) :
# SHELL_BASE_URL fait naviguer export-worker vers la BONNE page shell, mais
# une fois cette page chargée dans le Chromium d'export-worker, son propre
# JS appelle ensuite le cœur à l'URL que CE service shell a lui-même reçue
# via VITE_CORE_URL — au build (shell/Dockerfile ARG, défaut
# "http://localhost:8200"), ou à l'exécution via env-config.js (voir
# shell/src/config.ts::mergeRuntimeEnv, qui ne laisse une valeur runtime
# écraser le build que si elle est non vide). Le service "shell" du
# docker-compose.yml passe désormais VITE_CORE_URL (bloc environment:) à ce
# mécanisme d'injection runtime, avec pour défaut la même valeur que l'ARG
# de build ("http://localhost:8200") — donc un "docker compose up" sans
# override de VITE_CORE_URL se comporte EXACTEMENT comme avant (no-op).
# Cette variable ci-dessous est le vrai levier : la définir ici surcharge
# VITE_CORE_URL au runtime, sans rebuild de l'image shell.
#
# Il n'existe PAS de valeur unique correcte à la fois pour un navigateur
# humain sur l'hôte (dev local) ET pour export-worker (réseau docker
# interne) sans domaine public partagé routé par Traefik ET
# résolvable/joignable depuis le réseau docker (hairpin NAT) — un point
# d'exploitation propre à chaque déploiement. Pour activer un export réel
# (profil "export"), fixer VITE_CORE_URL à un hostname atteignable des DEUX
# côtés (ex. le domaine public Traefik, si le hairpin NAT le permet) —
# jamais "http://localhost:8200" (résolu depuis export-worker, pointe vers
# export-worker lui-même : chaque appel API de la page rendue échoue en
# 401/erreur réseau, capture "Accès refusé" au lieu d'un vrai rendu) ni
# simplement "http://core:8200" sans vérifier que ça ne casse pas le flux
# navigateur hôte (localhost:8300 appelant alors http://core:8200, non
# résolvable hors du réseau docker) si le shell reste aussi utilisé
# normalement en parallèle de l'export.
VITE_CORE_URL=
# Allowlist d'hôtes pour la garde d'egress SSRF des connecteurs de pipeline
# (reader.connector.rest, SP-15f) — liste séparée par des virgules ; vide
# (défaut) = seules les plages réseau internes/privées sont bloquées, aucune
# restriction d'hôte supplémentaire.
CORE_PIPELINES_EGRESS_ALLOWLIST=
# Allowlist d'hôtes pour la garde d'egress SSRF des webhooks d'alerte
# (AlertRule, SP-16b) — liste séparée par des virgules ; vide (défaut) =
# seules les plages réseau internes/privées sont bloquées, aucune
# restriction d'hôte supplémentaire.
CORE_ALERTS_EGRESS_ALLOWLIST=
# Allowlist d'hôtes pour la garde d'egress SSRF du moissonnage (connecteurs
# STAC/ArcGIS FS/WMS/WFS/WMTS/CSW/CKAN, SP-12) — liste séparée par des
# virgules ; vide (défaut) = seules les plages réseau internes/privées sont
# bloquées, aucune restriction d'hôte supplémentaire. Documentée ici mais
# jamais câblée dans docker-compose.yml jusqu'à SP-21 (angle mort de
# core_env_vars(), corrigé en même temps que cette ligne).
CORE_HARVEST_EGRESS_ALLOWLIST=

# ─── Observabilité (Grafana, profil compose `observability`) ─
# Point de contact webhook pour les alertes SLO Grafana (SP-26/3.7) —
# reçoit toute alerte du dossier SLO (voir
# deploy/observability/grafana/provisioning/alerting/{rules,contactpoints,
# policies}.yaml). Vide par défaut côté opérateur : docker-compose.yml
# retombe alors sur un localhost inatteignable
# (http://127.0.0.1:1/grafana-alert-webhook-not-configured) plutôt qu'une
# chaîne vide — vérifié empiriquement qu'une URL vide fait échouer le
# provisioning alerting de Grafana au démarrage et arrête tout le
# conteneur `otel-lgtm` (Grafana 12.0.1, image grafana/otel-lgtm:0.11.4).
# Régler cette valeur pour recevoir une vraie notification.
GRAFANA_ALERT_WEBHOOK_URL=

# ─── Cœur : coffre de secrets connecteurs (SP-15e) ───────
# Clé maître AES-256 (32 octets, encodée base64) chiffrant les secrets
# connecteurs au repos. Générer avec : openssl rand -base64 32
# Ne JAMAIS versionner la vraie valeur ; ce fichier ne contient qu'un
# exemple de format, pas une clé utilisable. Requise (pas de défaut) — le
# cœur refuse de démarrer sans elle (échec rapide, design SP-15e §4/§8).
CORE_SECRETS_MASTER_KEY=

# ─── Déploiement prod (SP-Deploy, docker-compose.prod.yml) ────
# Nom d'hôte public unique — source de vérité pour Keycloak (issuer,
# redirect_uri), le cœur (OIDC), le shell (API/tuiles) et Traefik (routage).
# Changer cette seule ligne + redémarrer les services concernés (jamais de
# `docker compose build`) suffit pour basculer d'un hôte à l'autre — ex.
# `machine.tailnet.ts.net` → `geostudio.tondomaine.fr`.
GEOSTUDIO_PUBLIC_HOST=changez-moi.exemple.ts.net
# Tag des huit images ghcr.io/tlenenao/geostudio-* à déployer (core, shell,
# postgis, backup, export-worker, qgis-worker, appexport-runtime-builder,
# appexport-standalone). `latest` suit la dernière image publiée : commode
# pour une première installation, mais NON reproductible — deux
# `docker compose pull` à deux dates donnent deux stacks différentes, et un
# rollback n'a plus rien à désigner. Ce défaut est donc un tag de release réel,
# publié par .github/workflows/release.yml — le remonter est un geste
# volontaire de mise à jour, pas un effet de bord d'un `docker compose pull`.
# À savoir (revue finale SP-21) : cette ligne est la seule qui décide du
# nombre de `:latest` dans le compose de production **résolu** (six si on la
# remet à `latest`). La mesure « 0 :latest » de SP-21 portait sur le compose
# de BASE — les images tierces (minio, keycloak, traefik, tailscale…), que
# nous pinnons nous-mêmes et qu'un opérateur ne choisit pas ; ce tag-ci est au
# contraire un choix d'opérateur, que `test_images_are_pinned` exempte pour
# cette raison sans rien affirmer sur sa valeur.
GEOSTUDIO_VERSION=v0.1.0

# Clé d'authentification Tailscale non-interactive (générée dans la console
# admin Tailscale, https://login.tailscale.com/admin/settings/keys — clé
# réutilisable, à courte durée de vie recommandée). Vide par défaut : le
# service `tunnel` ne démarre pas sans elle (voir installeur, SP-Deploy-c).
TS_AUTHKEY=

# Sub(s) OIDC (identifiant Keycloak) à promouvoir admin — liste séparée par
# des virgules, lue par le cœur à chaque requête (core/app/auth/dependency.py).
# Sans au moins un sub ici, personne ne peut jamais devenir admin après un
# déploiement propre (voir installeur, SP-Deploy-c, création du premier
# compte Keycloak).
CORE_ADMIN_SUBS=

# ─── Sauvegarde (SP-Deploy-b, service `backup`) ──────────
# Heure UTC (0-23) du backup quotidien.
BACKUP_HOUR=3
# Clé PUBLIQUE age (générée via `age-keygen`) — la clé privée ne doit
# JAMAIS être stockée sur cette machine ni dans ce dépôt (cf. runbook de
# restauration, docs/runbooks/2026-07-24-restauration-sauvegardes.md).
BACKUP_AGE_RECIPIENT=
# Cible hors-site S3-compatible (Cloudflare R2 gratuit ≤10 Go, Backblaze
# B2, Scaleway...). Laisser vide = sauvegarde locale seule (avertissement
# émis à chaque exécution).
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=geostudio-backups
