# ─── PostgreSQL / PostGIS ────────────────────────────────
PG_PASSWORD=ChangezMoiImmediatement!

# ─── MinIO (stockage objets S3-compatible) ───────────────
MINIO_USER=minioadmin
MINIO_PASSWORD=MinioSecret_ChangezMoi123

# ─── Keycloak (authentification SSO) ─────────────────────
KC_PASSWORD=KeycloakAdmin_ChangezMoi!

# ─── Apache Superset (BI spatiale) ───────────────────────
# Générer avec : openssl rand -base64 48
SUPERSET_SECRET=remplacez-par-une-cle-aleatoire-de-64-caracteres

# ─── Traefik / Let's Encrypt (SSL) ───────────────────────
ACME_EMAIL=admin@votre-domaine.fr
DOMAIN=gis.votre-domaine.fr

# ─── Martin (optionnel, clé JWT Keycloak) ────────────────
MARTIN_SECRET=martin-client-secret

# ─── Cœur : mode d'authentification ──────────────────────
# "mock" pour dev/e2e (aucun accès réseau à Keycloak requis) ; "oidc" en usage réel.
CORE_AUTH_MODE=mock
CORE_OIDC_ISSUER=http://keycloak:8080/realms/geostudio
CORE_OIDC_AUDIENCE=geostudio-core
