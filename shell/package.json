{
  "name": "geostudio-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api-types": "openapi-typescript ../core/openapi.json -o src/api/generated/core-schema.d.ts",
    "build:export-runtime": "vite build --config vite.export.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.0.0",
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/geo-layers": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@loaders.gl/3d-tiles": "^4.3.0",
    "@tanstack/react-query": "^5.59.0",
    "@xyflow/react": "^12.11.2",
    "cel-js": "^0.8.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "html-to-image": "^1.11.13",
    "lit": "^3.3.3",
    "maplibre-gl": "^4.7.0",
    "marked": "^18.0.6",
    "oidc-client-ts": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-oidc-context": "^3.2.0",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.5.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "postcss": "^8.5.18",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.47.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "jsdom": "^25.0.0",
    "msw": "^2.4.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  }
